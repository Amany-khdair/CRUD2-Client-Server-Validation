@model Users
@{
    Layout = "~/Views/Shared/_mainLayout.cshtml";
}
<div class="container mt-4">
    <a href="/Users/Index" class="btn btn-outline-dark mb-4">&larr; Back to Users</a>
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-lg border-0 rounded-3 m-5">
                <div class="card-header bg-dark text-white text-center py-3">
                    <h4 class="mb-0">Add User</h4>
                </div>

                <div class="card-body p-4">

                    <form method="post" asp-controller="Users" asp-action="Store">

                        <div class="mb-3">
                            <label class="form-label fw-bold" asp-for="Name"></label>
                            <input asp-for="Name" class="form-control" placeholder="Enter Name" required />
                            <span class="text-danger" asp-validation-for="Name"></span>
                        </div>                        

                        <div class="mb-3">
                            <label asp-for="Age" class="form-label fw-bold"></label>
                            <input asp-for="Age" value="@(Model.Age == 0 ? "" : Model.Age)" class="form-control" placeholder="Enter Age" required />
                            <span class="text-danger" asp-validation-for="Age"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="City" class="form-label fw-bold"></label>
                            <input asp-for="City" class="form-control" placeholder="Enter City" required />
                            <span class="text-danger" asp-validation-for="City"></span>
                        </div>

                        <button type="submit" class="btn btn-dark w-100 mt-2">
                            Add User
                        </button>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>